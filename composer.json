{
  "name": "weng/dev-theory-coach",
  "description": "Dev Theory Coach (THEORY_CORE) \u2014 PHP server-rendered interview concept trainer",
  "type": "project",
  "require": {
    "php": "^7.4 || ^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "TheoryCore\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "TheoryCore\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "serve": "php -S localhost:8080 index.php"
  }
}
